# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ─── AI / integrations (needed in later phases) ─────────────
ANTHROPIC_API_KEY=sk-ant-your-key
DEEPGRAM_API_KEY=your-deepgram-key
VOYAGE_API_KEY=your-voyage-key

# ─── Gmail API (interview invites) ──────────────────────────
# OAuth2 refresh-token flow. Create an OAuth client (Web) in Google Cloud,
# grant the https://www.googleapis.com/auth/gmail.send scope, and obtain a
# refresh token (e.g. via the OAuth Playground). Leave blank to disable email
# (scheduling still works — you just share the join link manually).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=CopilotHire <you@gmail.com>

# ─── LiveKit (in-app video interview) ───────────────────────
# Create a free project at cloud.livekit.io → copy the URL + API key/secret.
# Leave blank to disable video (interview falls back to audio-only transcription).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
